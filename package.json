{
  "name": "sts2-stagehand",
  "private": true,
  "type": "module",
  "dependencies": {
    "ws": "8.23.0",
    "godot-stagehand": "file:./stagehand"
  },
  "exports": "./sts2.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs && npm run test:launcher",
    "test:host": "dotnet run --project test/PublicCardList.test.csproj",
